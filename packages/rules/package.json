{
  "name": "@secretshield/rules",
  "version": "1.0.0",
  "description": "Declarative, versioned rule pack ecosystem for SecretShield",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "validate": "node -e \"import('./src/index.js').then(m => ['core', 'community', 'enterprise'].forEach(p => console.log(p, m.validateRulePackManifest(m.loadBuiltinPack(p)))))\"",
    "test": "node --test ../../tests/rules/rules.test.js",
    "build": "node -e \"process.exit(0)\"",
    "scan": "node ../cli/bin/secretshield.js scan . --config ../../.secretshield.json",
    "lint": "node --check src/index.js src/**/*.js"
  },
  "keywords": [
    "secretshield",
    "security",
    "secret-detection",
    "rule-packs",
    "regex",
    "credentials"
  ],
  "author": "SecretShield Team",
  "license": "Apache-2.0"
}

# ==============================================================================
# SecretShield — Production Environment Configuration Template
#
# INSTRUCTIONS:
# Copy this file to .env.local for local development.
# In production, set these variables in your deployment environment or secret manager.
#
# NEVER COMMIT REAL CREDENTIALS, KEYS, OR TOKENS TO SOURCE CONTROL.
# ==============================================================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# If omitted, SecretShield automatically runs on an isolated in-memory storage engine.
DATABASE_URL=

# Authentication (NextAuth / JWT Session signing)
# Generate a strong 32-byte secret: `openssl rand -base64 32`
AUTH_SECRET=

# GitHub App Integration (Optional)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# GitLab Integration (Optional)
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_WEBHOOK_SECRET=

# Notifications (Slack / Webhooks) (Optional)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Encryption at Rest (AES-256-GCM 32-byte hex or base64 key for secrets & tokens)
# Generate via: `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`
ENCRYPTION_KEY=

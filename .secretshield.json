{
  "severityThreshold": "high",
  "ignore": [
    "test-fixtures/**",
    "tests/**",
    "**/__tests__/**",
    "**/*.test.js",
    "**/*.spec.js",
    "scripts/**",
    "*.md",
    "**/*.md",
    "app-src/lib/scanner/rules/**",
    "packages/scanner/src/rules/**",
    "app-src/lib/scanner/demo-data.js",
    "packages/scanner/src/demo-data.js",
    "app-src/components/demo/**",
    "app-src/app/rules/lab/**",
    "app-src/app/docs/**",
    "app-src/lib/docs/**",
    "app-src/app/integrations/**",
    "app-src/lib/scanner/entropy.js",
    "packages/scanner/src/entropy.js",
    "app-src/lib/scanner/context.js",
    "packages/scanner/src/context.js",
    "app-src/lib/security/command-center.js",
    "app-src/app/api/findings/**",
    "app-src/app/api/projects/**",
    "app-src/app/api/pull-requests/**"
  ],
  "rules": {
    "aws-access-key": true,
    "github-token": true,
    "openai-api-key": true,
    "stripe-secret-key": true,
    "private-key": true,
    "database-url": true,
    "slack-webhook": true,
    "jwt": true,
    "redis-url": true
  },
  "scan": {
    "history": false,
    "maxFileSize": 2097152
  }
}
